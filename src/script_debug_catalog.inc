    { 0, #handler_ "(debug_menu_entry)" }
#define SCRIPT_HANDLER(label_, handler_) \
    { (label_), #handler_ "(debug_menu_entry)" }
#define SCRIPT_NOARG(label_, handler_) \
    { (label_), #handler_ "()" }

